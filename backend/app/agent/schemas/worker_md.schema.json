{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker_md",
  "type": "object",
  "additionalProperties": false,
  "required": ["workers"],
  "properties": {
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "worker_id",
          "name",
          "source_document",
          "demographics",
          "shift_context",
          "skills",
          "metric_derivation_reasoning"
        ],
        "properties": {
          "worker_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "source_document": { "type": ["string", "null"] },
          "demographics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "age",
              "gender",
              "years_of_experience",
              "baseline_physical_stamina",
              "cognitive_resilience"
            ],
            "properties": {
              "age": { "type": "integer", "minimum": 16, "maximum": 75 },
              "gender": { "type": "string", "enum": ["male", "female", "unspecified"] },
              "years_of_experience": { "type": "integer", "minimum": 0 },
              "baseline_physical_stamina": { "type": "number", "minimum": 0, "maximum": 1 },
              "cognitive_resilience": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "shift_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shift_id",
              "shift_start_time",
              "shift_end_time",
              "shift_duration_hours",
              "hours_worked_today",
              "consecutive_shifts"
            ],
            "properties": {
              "shift_id": { "type": "string", "minLength": 1 },
              "shift_start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "shift_end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "shift_duration_hours": { "type": "number", "minimum": 0, "maximum": 24 },
              "hours_worked_today": { "type": "number", "minimum": 0, "maximum": 24 },
              "consecutive_shifts": { "type": "integer", "minimum": 0 }
            }
          },
          "skills": {
            "type": "array",
            "minItems": 0,
            "maxItems": 24,
            "items": { "type": "string", "minLength": 2, "maxLength": 80 },
            "description": "Keahlian operasional pekerja, satu frasa singkat per entri."
          },
          "capabilities": {
            "type": "array",
            "maxItems": 24,
            "items": { "type": "string", "minLength": 2, "maxLength": 80 }
          },
          "certifications": {
            "type": "array",
            "maxItems": 24,
            "items": { "type": "string" }
          },
          "metric_derivation_reasoning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}