{
  "type": "object",
  "additionalProperties": false,
  "required": ["workers"],
  "properties": {
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "name", "demographics", "shift_context"],
        "properties": {
          "worker_id": { "type": "string" },
          "name": { "type": "string" },
          "demographics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "age",
              "gender",
              "years_of_experience",
              "baseline_physical_stamina",
              "cognitive_resilience"
            ],
            "properties": {
              "age": { "type": "integer", "minimum": 16, "maximum": 75 },
              "gender": {
                "type": "string",
                "enum": ["male", "female", "unspecified"]
              },
              "years_of_experience": { "type": "integer", "minimum": 0 },
              "baseline_physical_stamina": { "type": "number", "minimum": 0, "maximum": 1 },
              "cognitive_resilience": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "shift_context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hours_worked_today", "consecutive_shifts"],
            "properties": {
              "hours_worked_today": { "type": "number", "minimum": 0, "maximum": 24 },
              "consecutive_shifts": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}