{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "simulation_state",
  "type": "object",
  "additionalProperties": false,
  "required": ["live_simulation_state"],
  "properties": {
    "live_simulation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_assignments",
        "stage_utilization",
        "system_bottlenecks",
        "analytical_insight_summary"
      ],
      "properties": {
        "current_assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "worker_id",
              "assigned_job_id",
              "assigned_stage_id",
              "assigned_asset_id",
              "shift_id",
              "calculated_realtime_metrics"
            ],
            "properties": {
              "worker_id": { "type": "string" },
              "assigned_job_id": { "type": "string" },
              "assigned_stage_id": { "type": "string" },
              "assigned_asset_id": { "type": "string" },
              "shift_id": { "type": "string" },
              "calculated_realtime_metrics": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "current_fatigue_level",
                  "current_stress_level",
                  "effective_throughput_per_hour",
                  "effective_error_probability",
                  "burnout_hazard_risk"
                ],
                "properties": {
                  "current_fatigue_level": { "type": "number", "minimum": 0, "maximum": 1 },
                  "current_stress_level": { "type": "number", "minimum": 0, "maximum": 1 },
                  "effective_throughput_per_hour": { "type": "number", "minimum": 0 },
                  "effective_error_probability": { "type": "number", "minimum": 0, "maximum": 1 },
                  "burnout_hazard_risk": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  }
                }
              }
            }
          }
        },
        "stage_utilization": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage_id",
              "lane",
              "demanded_throughput_per_hour",
              "achieved_throughput_per_hour",
              "utilization_ratio",
              "queue_units",
              "starved_by_stage_ids"
            ],
            "properties": {
              "stage_id": { "type": "string" },
              "lane": { "type": "string" },
              "demanded_throughput_per_hour": { "type": "number", "minimum": 0 },
              "achieved_throughput_per_hour": { "type": "number", "minimum": 0 },
              "utilization_ratio": { "type": "number", "minimum": 0 },
              "queue_units": { "type": "number", "minimum": 0 },
              "starved_by_stage_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Jalur paralel yang membuat tahap ini menunggu bahan. Kosong bila tidak menunggu."
              }
            }
          },
          "description": "Wajib satu entri per tahap. Pada proses hybrid, tahap penggabung menunggu jalur paling lambat."
        },
        "system_bottlenecks": {
          "type": "array",
          "items": { "type": "string", "maxLength": 80 }
        },
        "analytical_insight_summary": { "type": "string", "maxLength": 600 }
      }
    }
  }
}