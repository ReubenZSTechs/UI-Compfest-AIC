{
  "type": "object",
  "additionalProperties": false,
  "required": ["factory_flow_rightnow", "llm_compatibility_and_evaluations"],
  "properties": {
    "factory_flow_rightnow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_timestamp", "note", "staff_current_positions"],
      "properties": {
        "snapshot_timestamp": { "type": "string" },
        "note": { "type": "string" },
        "staff_current_positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "worker_id",
              "name",
              "current_station",
              "current_asset_id",
              "activity_status",
              "moving_to_next_step",
              "handoff_item"
            ],
            "properties": {
              "worker_id": { "type": "string" },
              "name": { "type": "string" },
              "current_station": { "type": "string" },
              "current_asset_id": { "type": "string" },
              "activity_status": {
                "type": "string",
                "enum": [
                  "processing",
                  "waiting_on_machine",
                  "idle_waiting_input",
                  "on_break"
                ]
              },
              "moving_to_next_step": { "type": "string" },
              "handoff_item": { "type": "string" }
            }
          }
        }
      }
    },
    "llm_compatibility_and_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "worker_id",
          "job_id",
          "asset_id",
          "evaluations",
          "llm_reasoning"
        ],
        "properties": {
          "worker_id": { "type": "string" },
          "job_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "evaluations": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "overall_compatibility_score",
              "throughput_multiplier",
              "error_multiplier",
              "fatigue_accumulation_rate",
              "stress_sensitivity_factor"
            ],
            "properties": {
              "overall_compatibility_score": { "type": "number" },
              "throughput_multiplier": { "type": "number" },
              "error_multiplier": { "type": "number" },
              "fatigue_accumulation_rate": { "type": "number" },
              "stress_sensitivity_factor": { "type": "number" }
            }
          },
          "llm_reasoning": { "type": "string" }
        }
      }
    }
  }
}