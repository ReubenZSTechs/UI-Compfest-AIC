{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "factory_md",
  "type": "object",
  "additionalProperties": false,
  "required": ["factory_info", "shifts", "assets", "process_stages", "job_descriptions"],
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "unit", "unit_class", "basis"],
      "properties": {
        "raw": { "type": "string" },
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "type": ["string", "null"] },
        "unit_class": {
          "type": ["string", "null"],
          "enum": ["mass", "volume", "count", "power", "noise", null]
        },
        "basis": { "type": ["string", "null"] }
      }
    },
    "automation_level": {
      "type": "string",
      "enum": ["manual", "semi_automated", "automated"]
    }
  },
  "properties": {
    "factory_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory_id",
        "factory_name",
        "process_type",
        "declared_worker_count",
        "registered_worker_count",
        "layout_description",
        "workflow_sequence",
        "process_edges",
        "entry_stages",
        "terminal_stages",
        "parallel_groups",
        "lanes"
      ],
      "properties": {
        "factory_id": { "type": "string", "minLength": 1 },
        "factory_name": { "type": "string", "minLength": 1 },
        "process_type": {
          "type": "string",
          "enum": ["serial", "parallel", "hybrid"],
          "description": "DERIVASI: hybrid bila terdapat jalur paralel yang menyatu kembali ke jalur utama."
        },
        "declared_worker_count": {
          "type": "integer",
          "minimum": 0,
          "description": "SUMBER Excel Tabel 2: jumlah total kolom Jumlah_Pekerja."
        },
        "registered_worker_count": {
          "type": "integer",
          "minimum": 0,
          "description": "SUMBER Excel Tabel 4: banyaknya Worker_ID terdaftar."
        },
        "layout_description": { "type": "string" },
        "workflow_sequence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "DERIVASI: urutan topologis Tahap_ID, bukan urutan baris Excel."
        },
        "process_edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_stage_id", "to_stage_id"],
            "properties": {
              "from_stage_id": { "type": "string" },
              "to_stage_id": { "type": "string" }
            }
          },
          "description": "SUMBER Excel Tabel 1: pasangan Tahap_ID dan Next_Tahap_ID."
        },
        "entry_stages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "terminal_stages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "parallel_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group_id", "depth", "steps", "lanes", "converges_to", "reasoning"],
            "properties": {
              "group_id": { "type": "string" },
              "depth": { "type": "integer", "minimum": 0 },
              "steps": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              },
              "lanes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "converges_to": { "type": ["string", "null"] },
              "reasoning": { "type": "string" }
            }
          }
        },
        "lanes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "SUMBER Excel Tabel 1 kolom Jalur_Paralel, tanpa jalur utama."
        }
      }
    },
    "shifts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shift_id",
          "start_time",
          "end_time",
          "duration_hours",
          "crosses_midnight"
        ],
        "properties": {
          "shift_id": { "type": "string", "minLength": 1 },
          "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "duration_hours": { "type": "number", "minimum": 0, "maximum": 24 },
          "crosses_midnight": { "type": "boolean" }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "asset_name",
          "category",
          "units_available",
          "capacity_per_unit",
          "total_capacity",
          "automation_level",
          "is_automated",
          "operational_cost_per_hour",
          "currency",
          "environmental_factors",
          "metric_derivation_reasoning"
        ],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "asset_name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "machine",
              "measuring_equipment",
              "conveyor_automation",
              "environmental_chamber",
              "manual_station"
            ],
            "description": "DERIVASI LLM dari Nama_Peralatan."
          },
          "units_available": {
            "type": "integer",
            "minimum": 0,
            "description": "SUMBER Excel Tabel 3 kolom Jumlah_Unit."
          },
          "capacity_per_unit": { "$ref": "#/$defs/quantity" },
          "total_capacity": { "$ref": "#/$defs/quantity" },
          "automation_level": { "$ref": "#/$defs/automation_level" },
          "is_automated": {
            "type": "boolean",
            "description": "DERIVASI: true hanya bila automation_level bernilai automated."
          },
          "operational_cost_per_hour": {
            "type": "number",
            "minimum": 0,
            "description": "SUMBER Excel Tabel 3 kolom Biaya_Operasional_per_Jam."
          },
          "currency": { "type": "string", "enum": ["IDR"] },
          "environmental_factors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "power_consumption_watt",
              "noise_level_db",
              "vibration_hazard_level",
              "physical_strain_index"
            ],
            "properties": {
              "power_consumption_watt": {
                "type": ["number", "null"],
                "minimum": 0,
                "description": "SUMBER Excel Tabel 3 kolom Konsumsi_Daya_Faktor_Lingkungan."
              },
              "noise_level_db": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 140,
                "description": "SUMBER Excel Tabel 3, bukan estimasi LLM."
              },
              "vibration_hazard_level": {
                "type": "string",
                "enum": ["low", "medium", "high"],
                "description": "DERIVASI LLM."
              },
              "physical_strain_index": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "DERIVASI LLM."
              }
            }
          },
          "metric_derivation_reasoning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "process_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "stage_name",
          "lane",
          "next_stage_id",
          "is_terminal",
          "asset_id",
          "operator_task",
          "material_input",
          "material_output",
          "material_per_batch",
          "flow_type",
          "cycle_time_seconds",
          "throughput",
          "throughput_per_hour",
          "automation_level",
          "qc_requirement",
          "metric_derivation_reasoning"
        ],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "stage_name": { "type": "string", "minLength": 1 },
          "lane": { "type": "string" },
          "next_stage_id": {
            "type": ["string", "null"],
            "description": "null bila tahap terminal (Excel menuliskan Finished)."
          },
          "is_terminal": { "type": "boolean" },
          "asset_id": { "type": "string", "minLength": 1 },
          "operator_task": { "type": "string" },
          "material_input": {
            "type": "array",
            "items": { "type": "string" }
          },
          "material_output": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "material_per_batch": {
            "type": "array",
            "items": { "$ref": "#/$defs/quantity" }
          },
          "flow_type": {
            "type": "string",
            "enum": ["batch", "continuous"]
          },
          "cycle_time_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "SUMBER Excel Tabel 1 kolom Waktu_Siklus_Standar, dikonversi ke detik."
          },
          "throughput": { "$ref": "#/$defs/quantity" },
          "throughput_per_hour": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "DERIVASI: throughput dinormalisasi memakai cycle_time_seconds bila basisnya batch."
          },
          "automation_level": { "$ref": "#/$defs/automation_level" },
          "qc_requirement": { "type": "string" },
          "metric_derivation_reasoning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "job_descriptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "allocation_id",
          "job_title",
          "stage_id",
          "assigned_asset_id",
          "assigned_worker_ids",
          "shift_id",
          "headcount",
          "demands",
          "qc_requirement",
          "metric_derivation_reasoning"
        ],
        "properties": {
          "job_id": { "type": "string", "minLength": 1 },
          "allocation_id": {
            "type": "string",
            "minLength": 1,
            "description": "SUMBER Excel Tabel 2 kolom Alokasi_ID."
          },
          "job_title": { "type": "string", "minLength": 1 },
          "stage_id": { "type": "string", "minLength": 1 },
          "assigned_asset_id": { "type": "string", "minLength": 1 },
          "assigned_worker_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "SUMBER Excel Tabel 2, panjang array wajib sama dengan headcount."
          },
          "shift_id": { "type": "string", "minLength": 1 },
          "headcount": { "type": "integer", "minimum": 1 },
          "demands": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_cognitive_focus",
              "physical_demand_level",
              "task_complexity",
              "error_severity"
            ],
            "properties": {
              "required_cognitive_focus": { "type": "number", "minimum": 0, "maximum": 1 },
              "physical_demand_level": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "task_complexity": { "type": "number", "minimum": 0, "maximum": 1 },
              "error_severity": {
                "type": "string",
                "enum": ["low", "moderate", "high", "critical"]
              }
            }
          },
          "qc_requirement": { "type": "string" },
          "metric_derivation_reasoning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}